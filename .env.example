# ===========================================================================
# LEGAFY AI — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to `.env` and fill in. NEVER commit the populated `.env`.
# ===========================================================================

# --- Service identity -------------------------------------------------------
LEGAFY_ENV=production                 # production | staging | development
LEGAFY_HOST=0.0.0.0
LEGAFY_PORT=8000
LEGAFY_LOG_LEVEL=INFO
LEGAFY_PUBLIC_BASE_URL=https://legal-mcp.akridion.com

# --- Telemetry / audit vault ------------------------------------------------
# HMAC salt used to pseudonymise business-concept strings before they are
# written to the audit vault. Generate with: openssl rand -hex 32
# Rotating this salt permanently breaks correlation with older vault records.
LEGAFY_TELEMETRY_SALT=CHANGE_ME_openssl_rand_hex_32
LEGAFY_AUDIT_VAULT_PATH=generated/akrigon_audit_vault.json
LEGAFY_GENERATED_DIR=generated

# --- Multi-tenant licence registry -----------------------------------------
# Either point at a JSON registry file (recommended) or rely on the built-in
# bootstrap tokens (development only — they are refused when LEGAFY_ENV=production).
LEGAFY_LICENSE_REGISTRY_PATH=data/license_registry.json
LEGAFY_BOOTSTRAP_TOKENS_ENABLED=false

# --- Rate limiting ----------------------------------------------------------
LEGAFY_RATELIMIT_BACKEND=memory       # memory | redis
LEGAFY_REDIS_URL=redis://redis:6379/0

# --- Model-agnostic provider router ----------------------------------------
# Comma-separated priority chain. First healthy provider wins; the rest are
# failover targets. `offline` is a deterministic, no-network provider used for
# CI, air-gapped runs and smoke tests.
LEGAFY_PROVIDER_CHAIN=anthropic,openai,ollama,offline

ANTHROPIC_API_KEY=
LEGAFY_ANTHROPIC_MODEL=claude-sonnet-4-5

OPENAI_API_KEY=
LEGAFY_OPENAI_MODEL=gpt-4o
LEGAFY_OPENAI_BASE_URL=https://api.openai.com/v1

# Local CPU-server inference (llama.cpp / Ollama). No API key required.
LEGAFY_OLLAMA_BASE_URL=http://host.docker.internal:11434
LEGAFY_OLLAMA_MODEL=llama3.1:8b

# --- Chunk-assembly pipeline ------------------------------------------------
LEGAFY_CHUNK_MAX_TOKENS=3000          # per-chunk output ceiling
LEGAFY_CHUNK_CONTINUATIONS=4          # max continuation passes per chunk
LEGAFY_CHUNK_CONCURRENCY=1            # 1 = strictly sequential (context fidelity)
LEGAFY_MIN_DOCUMENT_WORDS=10000       # ~20 pages at 500 words/page

# --- Cloudflare tunnel ------------------------------------------------------
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_TUNNEL_NAME=akridion-legal-tunnel
CLOUDFLARE_HOSTNAME=legal-mcp.akridion.com

# --- Government verification APIs (API Setu and equivalents) ----------------
# Optional. These verify the CALLER'S OWN registrations (GSTIN, Udyam, PAN, CIN)
# and are NEVER a source of law. With no key, verify_registration returns
# NOT_CONFIGURED and hands back the manual search — it never pretends.
# Confirm each path in data/gov_api_endpoints.json against your own API Setu
# subscription before relying on a check.
LEGAFY_GOV_API_BASE_URL=https://apisetu.gov.in/api
LEGAFY_GOV_API_KEY=
LEGAFY_GOV_API_CLIENT_ID=
